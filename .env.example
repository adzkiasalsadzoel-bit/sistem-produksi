# ========== Supabase ==========
# Project Settings → API (cloud) atau output `npx supabase start` (lokal)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya server. Jangan pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ========== Aplikasi ==========
# URL publik aplikasi (dipakai untuk link lacak di pesan WA & Origin upload Drive)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Garam untuk hash IP rate limit halaman lacak (isi string acak panjang)
RATE_LIMIT_SALT=ganti-dengan-string-acak

# ========== Google Drive (Service Account) ==========
# Opsi A (disarankan di Vercel): isi JSON service account dalam bentuk base64 satu baris
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Opsi B: email + private key terpisah (ganti baris baru di key dengan \n)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Opsional: ID Shared Drive default (bisa juga dipilih di halaman Pengaturan)
GOOGLE_SHARED_DRIVE_ID=
# File gambar ≤ batas ini dibaca server dengan sharp untuk dimensi & preview (MB)
PREVIEW_MAX_DOWNLOAD_MB=150
